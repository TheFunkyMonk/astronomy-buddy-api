# Pulled from Bitwarden, from the "Astronomy Buddy API Deploy" item: each
# secret is a custom field on it. Names only, so this file is safe to commit.
# KAMAL_REGISTRY_PASSWORD is the same GitHub token BookPocket deploys with.
SECRETS=$(kamal secrets fetch --adapter bitwarden --account rjlacount@gmail.com --from "Astronomy Buddy API Deploy" KAMAL_REGISTRY_PASSWORD ASTRONOMY_API_APP_ID ASTRONOMY_API_APP_SECRET)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
ASTRONOMY_API_APP_ID=$(kamal secrets extract ASTRONOMY_API_APP_ID ${SECRETS})
ASTRONOMY_API_APP_SECRET=$(kamal secrets extract ASTRONOMY_API_APP_SECRET ${SECRETS})
